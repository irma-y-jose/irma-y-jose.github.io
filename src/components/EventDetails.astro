---
import { wedding } from "../data/wedding";

const events = [wedding.events.ceremony, wedding.events.reception];
---

<section id="evento" class="bg-paper-alt py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <p class="text-center font-display text-sm tracking-[0.3em] uppercase text-accent" data-reveal>
      El gran día
    </p>
    <h2 class="mt-3 text-center font-display text-4xl text-ink sm:text-5xl" data-reveal>
      Ceremonia &amp; Recepción
    </h2>

    <div class="mt-16 grid gap-8 md:grid-cols-2">
      {events.map((event, i) => (
        <div
          class="group rounded-sm border border-line bg-paper p-8 transition-shadow duration-500 hover:shadow-xl sm:p-10"
          data-reveal
          style={`transition-delay:${i * 120}ms`}
        >
          <span class="font-display text-sm tracking-widest text-accent">{event.time}</span>
          <h3 class="mt-2 font-display text-2xl text-ink sm:text-3xl">{event.title}</h3>
          <p class="mt-4 text-base text-ink">{event.name}</p>
          <p class="text-sm text-ink-soft">{event.address}</p>
          <a
            href={`https://maps.google.com/?q=${encodeURIComponent(event.mapQuery)}`}
            target="_blank"
            rel="noopener"
            class="mt-6 inline-flex items-center gap-2 text-sm tracking-wide text-accent underline-offset-4 transition-colors group-hover:underline"
          >
            Ver en el mapa <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
