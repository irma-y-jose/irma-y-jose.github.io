---
import { wedding } from "../data/wedding";

const event = wedding.events.main;
---

<section id="evento" class="bg-paper-alt py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <p class="text-center font-display text-sm tracking-[0.3em] uppercase text-accent" data-reveal>
      El gran día
    </p>
    <h2 class="mt-3 text-center font-display text-4xl text-ink sm:text-5xl" data-reveal>
      Ceremonia &amp; Recepción
    </h2>

    <div class="mt-16 mx-auto max-w-md">
      <div
        class="rounded-sm border border-line bg-paper p-8 text-center transition-shadow duration-500 hover:shadow-xl sm:p-10"
        data-reveal
      >
        <span class="font-display text-sm tracking-widest text-accent">{event.time}</span>
        <h3 class="mt-2 font-display text-2xl text-ink sm:text-3xl">{event.title}</h3>
        <p class="mt-4 text-base text-ink">{event.name}</p>
      </div>
    </div>
  </div>
</section>
