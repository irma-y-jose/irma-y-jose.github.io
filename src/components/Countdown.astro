---
import { wedding } from "../data/wedding";

const units = [
  { key: "days", label: "Días" },
  { key: "hours", label: "Horas" },
  { key: "minutes", label: "Min" },
  { key: "seconds", label: "Seg" },
];
---

<section class="border-y border-line bg-paper-alt py-14" data-reveal>
  <div class="mx-auto max-w-3xl px-6 text-center">
    <p class="font-display text-sm tracking-[0.3em] uppercase text-ink-soft">Cuenta regresiva</p>
    <div
      id="countdown"
      class="mt-8 grid grid-cols-4 gap-3 sm:gap-6"
      data-target={wedding.date.iso}
    >
      {units.map((unit) => (
        <div class="rounded-sm bg-paper px-2 py-5 shadow-sm sm:px-4 sm:py-7">
          <span
            class="block font-display text-3xl tabular-nums text-ink sm:text-5xl"
            data-unit={unit.key}
          >
            00
          </span>
          <span class="mt-2 block text-[10px] tracking-[0.2em] uppercase text-ink-soft sm:text-xs">
            {unit.label}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const el = document.getElementById("countdown")!;
  const target = new Date(el.dataset.target!).getTime();
  const fields = {
    days: el.querySelector('[data-unit="days"]')!,
    hours: el.querySelector('[data-unit="hours"]')!,
    minutes: el.querySelector('[data-unit="minutes"]')!,
    seconds: el.querySelector('[data-unit="seconds"]')!,
  };

  function pad(n: number) {
    return String(Math.max(n, 0)).padStart(2, "0");
  }

  function tick() {
    const diff = target - Date.now();
    const clamped = Math.max(diff, 0);
    const days = Math.floor(clamped / 86400000);
    const hours = Math.floor((clamped % 86400000) / 3600000);
    const minutes = Math.floor((clamped % 3600000) / 60000);
    const seconds = Math.floor((clamped % 60000) / 1000);

    fields.days.textContent = pad(days);
    fields.hours.textContent = pad(hours);
    fields.minutes.textContent = pad(minutes);
    fields.seconds.textContent = pad(seconds);

    if (diff <= 0) clearInterval(interval);
  }

  tick();
  const interval = setInterval(tick, 1000);
</script>
