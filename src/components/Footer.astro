---
import { wedding } from "../data/wedding";
---

<footer class="bg-ink py-14 text-center text-paper">
  <p class="font-display text-2xl italic">
    {wedding.couple.bride} &amp; {wedding.couple.groom}
  </p>
  <p class="mt-3 text-xs tracking-[0.3em] uppercase text-paper/60">
    {wedding.date.display}
  </p>
  <p class="mt-8 text-[11px] text-paper/40">
    Hecho con cariño para nuestra boda
  </p>
</footer>
