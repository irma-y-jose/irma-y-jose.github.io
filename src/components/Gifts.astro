---
import { wedding } from "../data/wedding";
---

<section id="regalos" class="bg-paper-alt py-24 md:py-32">
  <div class="mx-auto max-w-xl px-6 text-center md:px-10">
    <p class="font-display text-sm tracking-[0.3em] uppercase text-accent" data-reveal>
      De corazón
    </p>
    <h2 class="mt-3 font-display text-4xl text-ink sm:text-5xl" data-reveal>Lluvia de sobres</h2>
    <p class="mt-6 text-sm leading-relaxed text-ink-soft" data-reveal>
      {wedding.gifts.note}
    </p>
  </div>
</section>
