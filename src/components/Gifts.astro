---
import { wedding } from "../data/wedding";
---

<section id="regalos" class="bg-paper-alt py-24 md:py-32">
  <div class="mx-auto max-w-xl px-6 text-center md:px-10">
    <p class="font-display text-sm tracking-[0.3em] uppercase text-accent" data-reveal>
      Con cariño
    </p>
    <h2 class="mt-3 font-display text-4xl text-ink sm:text-5xl" data-reveal>Mesa de regalos</h2>
    <p class="mt-6 text-sm leading-relaxed text-ink-soft" data-reveal>
      {wedding.gifts.note}
    </p>
    <a
      href={wedding.gifts.linkUrl}
      class="mt-8 inline-block rounded-full border border-ink px-8 py-3 text-sm tracking-wide transition-colors duration-300 hover:bg-ink hover:text-paper"
      data-reveal
    >
      {wedding.gifts.linkLabel}
    </a>
  </div>
</section>
