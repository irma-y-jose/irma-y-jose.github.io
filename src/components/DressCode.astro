---
import { wedding } from "../data/wedding";
---

<section id="vestimenta" class="bg-paper-alt py-24 md:py-32">
  <div class="mx-auto max-w-xl px-6 text-center md:px-10">
    <p class="font-display text-sm tracking-[0.3em] uppercase text-accent" data-reveal>
      Dress code
    </p>
    <h2 class="mt-3 font-display text-4xl text-ink sm:text-5xl" data-reveal>
      {wedding.dressCode.title}
    </h2>
    <p class="mt-6 text-sm leading-relaxed text-ink-soft" data-reveal>
      {wedding.dressCode.note}
    </p>

    <div class="mt-8 flex justify-center gap-3" data-reveal>
      {["#fbe1ea", "#f6b7c9", "#ef89ad", "#c24a78", "#e8dcc8"].map((color) => (
        <span
          class="h-8 w-8 rounded-full border border-line/60 shadow-sm"
          style={`background-color:${color}`}
        ></span>
      ))}
    </div>
  </div>
</section>
