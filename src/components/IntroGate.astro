---
import { wedding } from "../data/wedding";
---

<div
  id="intro-gate"
  class="fixed inset-0 z-[60] flex flex-col items-center justify-center gap-5 bg-paper-alt px-6 text-center transition-opacity duration-700"
>
  <p class="font-sans text-xs tracking-[0.4em] uppercase text-ink-soft">
    {wedding.hero.eyebrow}
  </p>
  <h1 class="font-display text-5xl text-ink sm:text-6xl">
    {wedding.couple.bride} <span class="italic text-accent">&amp;</span> {wedding.couple.groom}
  </h1>
  <p class="font-display text-sm tracking-widest text-ink-soft">
    {wedding.date.display}
  </p>
  <button
    type="button"
    id="open-invitation"
    class="mt-6 rounded-full bg-ink px-8 py-3.5 text-sm tracking-wide text-paper transition-transform duration-300 hover:scale-[1.02] active:scale-[0.98]"
  >
    Abrir invitación 💌
  </button>
</div>

<script>
  const gate = document.getElementById("intro-gate")!;
  const button = document.getElementById("open-invitation")!;

  document.documentElement.classList.add("overflow-hidden");

  button.addEventListener("click", () => {
    document.documentElement.classList.remove("overflow-hidden");
    gate.classList.add("opacity-0", "pointer-events-none");
    setTimeout(() => gate.remove(), 700);
  });
</script>
