---
import { Image } from "astro:assets";
import coupleImage from "../assets/couple/couple.jpg";
import { wedding } from "../data/wedding";
---

<section id="historia" class="mx-auto max-w-6xl px-6 py-24 md:px-10 md:py-32">
  <div class="grid gap-14 md:grid-cols-2 md:items-center md:gap-20">
    <div data-reveal>
      <Image
        src={coupleImage}
        alt={`${wedding.couple.groom} y ${wedding.couple.bride}`}
        widths={[400, 700, 900]}
        sizes="(min-width: 768px) 40vw, 90vw"
        format="webp"
        quality={80}
        loading="lazy"
        class="aspect-[4/5] w-full rounded-sm object-cover shadow-lg"
      />
    </div>

    <div>
      <p class="font-display text-sm tracking-[0.3em] uppercase text-accent" data-reveal>
        {wedding.story.eyebrow}
      </p>
      <h2 class="mt-3 font-display text-4xl text-ink sm:text-5xl" data-reveal>
        {wedding.story.title}
      </h2>

      <ol class="mt-10 space-y-8 border-l border-line pl-8">
        {wedding.story.milestones.map((m, i) => (
          <li class="relative" data-reveal style={`transition-delay:${i * 90}ms`}>
            <span class="absolute -left-[calc(2rem+5px)] top-1.5 h-2.5 w-2.5 rounded-full bg-accent"></span>
            <span class="font-display text-sm tracking-widest text-accent">{m.year}</span>
            <h3 class="mt-1 font-display text-xl text-ink">{m.title}</h3>
            {m.text && <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-soft">{m.text}</p>}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
