---
import { wedding } from "../data/wedding";
---

<section id="solo-adultos" class="mx-auto max-w-xl px-6 py-24 text-center md:px-10 md:py-32">
  <p class="font-display text-sm tracking-[0.3em] uppercase text-accent" data-reveal>
    Un pequeño favor
  </p>
  <h2 class="mt-3 font-display text-4xl text-ink sm:text-5xl" data-reveal>
    {wedding.adultsOnly.title}
  </h2>
  <p class="mt-6 text-sm leading-relaxed text-ink-soft" data-reveal>
    {wedding.adultsOnly.note}
  </p>
</section>
