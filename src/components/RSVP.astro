---
import { wedding } from "../data/wedding";
---

<section id="rsvp" class="mx-auto max-w-xl px-6 py-24 text-center md:px-10 md:py-32">
  <p class="font-display text-sm tracking-[0.3em] uppercase text-accent" data-reveal>
    Confirmación
  </p>
  <h2 class="mt-3 font-display text-4xl text-ink sm:text-5xl" data-reveal>Confirma tu asistencia</h2>
  <p class="mt-4 text-sm text-ink-soft" data-reveal>Antes del {wedding.rsvpDeadline}</p>

  <div class="relative mt-10" data-reveal>
    <form id="rsvp-form" class="grid gap-5 text-left transition-opacity duration-500" novalidate>
      <label class="grid gap-1.5 text-sm text-ink-soft">
        Nombre completo
        <input
          type="text"
          name="name"
          required
          class="rounded-sm border border-line bg-paper px-4 py-3 text-ink outline-none transition-colors focus:border-accent"
        />
      </label>
      <label class="grid gap-1.5 text-sm text-ink-soft">
        ¿Asistirás?
        <select
          name="attendance"
          required
          class="rounded-sm border border-line bg-paper px-4 py-3 text-ink outline-none transition-colors focus:border-accent"
        >
          <option value="">Selecciona una opción</option>
          <option value="si">Sí, con gusto</option>
          <option value="no">No podré asistir</option>
        </select>
      </label>
      <label class="grid gap-1.5 text-sm text-ink-soft">
        Número de acompañantes
        <input
          type="number"
          name="guests"
          min="0"
          value="0"
          class="rounded-sm border border-line bg-paper px-4 py-3 text-ink outline-none transition-colors focus:border-accent"
        />
      </label>
      <label class="grid gap-1.5 text-sm text-ink-soft">
        Mensaje para los novios (opcional)
        <textarea
          name="message"
          rows="3"
          class="rounded-sm border border-line bg-paper px-4 py-3 text-ink outline-none transition-colors focus:border-accent"
        ></textarea>
      </label>
      <button
        type="submit"
        class="mt-2 rounded-full bg-ink px-8 py-3.5 text-sm tracking-wide text-paper transition-transform duration-300 hover:scale-[1.02] active:scale-[0.98]"
      >
        Enviar confirmación
      </button>
      <p class="text-xs text-ink-soft/70">
        * Esta confirmación es una simulación de prueba (no se envía a ningún servidor todavía).
      </p>
    </form>

    <div
      id="rsvp-success"
      class="pointer-events-none absolute inset-0 flex scale-95 flex-col items-center justify-center gap-3 rounded-sm bg-paper opacity-0 transition-all duration-500"
    >
      <span class="text-4xl">✓</span>
      <p class="font-display text-2xl text-ink" id="rsvp-success-name">¡Gracias por confirmar!</p>
      <p class="text-sm text-ink-soft" id="rsvp-success-detail"></p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("rsvp-form") as HTMLFormElement;
  const success = document.getElementById("rsvp-success")!;
  const successName = document.getElementById("rsvp-success-name")!;
  const successDetail = document.getElementById("rsvp-success-detail")!;

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const data = new FormData(form);
    const name = String(data.get("name") || "").split(" ")[0];
    const attendance = data.get("attendance");
    const guests = data.get("guests");

    successName.textContent = attendance === "si" ? `¡Nos vemos ahí, ${name}!` : `Gracias, ${name}.`;
    successDetail.textContent =
      attendance === "si"
        ? `Confirmado con ${guests} acompañante(s).`
        : "Lamentamos que no puedas acompañarnos.";

    form.classList.add("pointer-events-none", "opacity-0");
    success.classList.remove("opacity-0", "pointer-events-none", "scale-95");
    success.classList.add("scale-100");
  });
</script>
