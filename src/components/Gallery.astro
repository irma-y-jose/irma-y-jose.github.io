---
import { Image } from "astro:assets";
import photo1 from "../assets/gallery/photo-1.jpg";
import photo2 from "../assets/gallery/photo-2.jpg";
import photo3 from "../assets/gallery/photo-3.jpg";
import photo4 from "../assets/gallery/photo-4.jpg";
import photo5 from "../assets/gallery/photo-5.jpg";
import photo6 from "../assets/gallery/photo-6.jpg";

const photos = [photo1, photo2, photo3, photo4, photo5, photo6];
---

<section id="galeria" class="mx-auto max-w-6xl px-6 py-24 md:px-10 md:py-32">
  <p class="text-center font-display text-sm tracking-[0.3em] uppercase text-accent" data-reveal>
    Momentos
  </p>
  <h2 class="mt-3 text-center font-display text-4xl text-ink sm:text-5xl" data-reveal>
    Galería
  </h2>

  <div class="mt-14 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3">
    {photos.map((photo, i) => (
      <button
        type="button"
        class="gallery-item group relative overflow-hidden rounded-sm"
        data-index={i}
        aria-label={`Ver foto ${i + 1} en grande`}
        data-reveal
        style={`transition-delay:${(i % 3) * 90}ms`}
      >
        <Image
          src={photo}
          alt=""
          widths={[300, 500, 700]}
          sizes="(min-width: 768px) 30vw, 45vw"
          format="webp"
          quality={75}
          loading="lazy"
          class="aspect-[4/5] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
        />
        <span class="absolute inset-0 bg-black/0 transition-colors duration-500 group-hover:bg-black/10"></span>
      </button>
    ))}
  </div>
</section>

<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4 opacity-0 transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-label="Visor de galería"
>
  <button
    type="button"
    id="lightbox-close"
    class="absolute right-5 top-5 text-3xl leading-none text-paper/80 transition-colors hover:text-paper"
    aria-label="Cerrar"
  >
    &times;
  </button>
  <button
    type="button"
    id="lightbox-prev"
    class="absolute left-3 text-3xl text-paper/70 transition-colors hover:text-paper sm:left-8"
    aria-label="Foto anterior"
  >
    &#8249;
  </button>
  <img id="lightbox-img" src="" alt="" class="max-h-[85vh] max-w-[90vw] rounded-sm object-contain" />
  <button
    type="button"
    id="lightbox-next"
    class="absolute right-3 text-3xl text-paper/70 transition-colors hover:text-paper sm:right-8"
    aria-label="Foto siguiente"
  >
    &#8250;
  </button>
</div>

<script>
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>(".gallery-item"));
  const sources = items.map((item) => item.querySelector("img")!.currentSrc || item.querySelector("img")!.src);

  const lightbox = document.getElementById("lightbox")!;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
  let current = 0;

  function open(index: number) {
    current = index;
    lightboxImg.src = sources[current];
    lightbox.classList.remove("hidden");
    requestAnimationFrame(() => lightbox.classList.remove("opacity-0"));
    document.body.style.overflow = "hidden";
  }

  function close() {
    lightbox.classList.add("opacity-0");
    document.body.style.overflow = "";
    setTimeout(() => lightbox.classList.add("hidden"), 300);
  }

  function show(delta: number) {
    current = (current + delta + sources.length) % sources.length;
    lightboxImg.src = sources[current];
  }

  items.forEach((item, i) => item.addEventListener("click", () => open(i)));
  document.getElementById("lightbox-close")!.addEventListener("click", close);
  document.getElementById("lightbox-prev")!.addEventListener("click", () => show(-1));
  document.getElementById("lightbox-next")!.addEventListener("click", () => show(1));
  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) close();
  });
  document.addEventListener("keydown", (e) => {
    if (lightbox.classList.contains("hidden")) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") show(-1);
    if (e.key === "ArrowRight") show(1);
  });
</script>
